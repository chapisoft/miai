# ==============================================================================
# MIAI ENVIRONMENT CONFIGURATION
# Enterprise Golden Standard AI Foundation
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=miai
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Authentication
API_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Unified LLM Provider Settings (vLLM on RTX 3060 GPU micro-server)
DEFAULT_LLM_PROVIDER=VLLM
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
EMBEDDING_PROVIDER=LOCAL_CPU

# Local Ollama Core Engine (Legacy / Fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=qwen2.5:7b
DEFAULT_VISION_MODEL=qwen2.5vl:7b
DEFAULT_EMBEDDING_MODEL=bge-m3

# Face Biometrics Engine (UniFace)
DEFAULT_FACE_DETECTOR=SCRFD
DEFAULT_FACE_RECOGNIZER=ADAFACE_IR50
FACE_SIMILARITY_THRESHOLD=0.60
FACE_LIVENESS_THRESHOLD=0.80
FACE_QUALITY_MIN_THRESHOLD=0.50

# Cloud AI Providers (Optional / Fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# PostgreSQL with pgvector Extension (Shared postgres-db port 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=miai_db
POSTGRES_USER=micro
POSTGRES_PASSWORD=Micro@31122020
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Cache & Session Memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ClickHouse OLAP (Analytics & Text-to-SQL)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics_db
CLICKHOUSE_USER=micro
CLICKHOUSE_PASSWORD=

# Observability & Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=ecs_json
